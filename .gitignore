# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Credenciales que NO se commitean nunca.
#
# La clave de cuenta de servicio de Firebase llega como un .json cualquiera desde
# el navegador, y el camino natural es dejarla caer en la carpeta del proyecto
# "un momentito" para subirla a EAS. Un .json no llama la atención en un
# `git status`, y quien lo tenga puede mandar notificaciones en nombre de la app.
google-services.json
GoogleService-Info.plist
*firebase-adminsdk*.json
*service-account*.json
*serviceaccount*.json

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# salida del compilador para las pruebas del motor de emparejamiento
/.tmp-test
